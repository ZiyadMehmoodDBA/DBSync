{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Node": {
    "NodeId": "",
    "GroupId": "",
    "SyncUrl": ""
  },
  "Jwt": {
    "Issuer": "msosync",
    "Audience": "msosync-dashboard",
    "AccessExpiryMinutes": 60,
    "RefreshExpiryDays": 7
  },
  "Heartbeat": {
    "IntervalSeconds": 30,
    "ProbeIntervalSeconds": 60,
    "StatusCheckIntervalSeconds": 60,
    "MissedThreshold": 3
  },
  "Sync": {
    "IntervalSeconds": 30,
    "PullIntervalSeconds": 10
  },
  "Export": {
    "ImmediateThreshold": 50000,
    "BasePath": "exports",
    "RetentionHours": 24,
    "MaxConcurrentJobs": 1
  },
  "Pagination": {
    "CursorHmacKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Lifecycle": {
    "RollingWorkerIntervalSeconds": 15
  },
  "Replay": {
    "MaxRangeDays": 90,
    "WorkerIntervalSeconds": 10,
    "MaxConcurrentOperations": 5,
    "ItemPageSize": 50
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultExpiry": "00:05:00"
  }
}
